{
  "rules": {
    "Attendance": {
      ".read": true,
      "$employeeId": {
        "$date": {
          ".read": true,
          ".write": true,
          ".validate": "(!data.exists() && newData.child('employeeId').val() === $employeeId && newData.child('date').val() === $date && newData.hasChild('sessions') && newData.child('sessions').hasChildren()) || (data.exists() && newData.child('employeeId').val() === data.child('employeeId').val() && newData.child('date').val() === data.child('date').val() && newData.hasChild('sessions')) || (data.exists() && newData.child('employeeId').val() === $employeeId && newData.child('date').val() === $date && newData.child('manualEdited').val() === true)"
        }
      }
    },
    "AttendanceSummary": {
      ".read": true,
      "$employeeId": {
        ".read": true,
        ".write": true
      }
    },
    "PunchRequests": {
      ".read": true,
      "$employeeId": {
        "$date": {
          ".read": true,
          ".write": true
        }
      }
    },
    "CompensationRequests": {
      ".read": true,
      "$employeeId": {
        ".read": true,
        ".write": true,
        "$requestId": {
          ".read": true,
          ".write": true
        }
      }
    },
    "users": {
      ".read": true,
      "$employeeId": {
        ".read": true,
        ".write": true,
        ".validate": "(!data.exists() && newData.child('role').val() === 'employee') || (data.exists() && (newData.child('role').val() === data.child('role').val() || newData.child('role').val() === 'admin' || newData.child('role').val() === 'superadmin'))",
        "role": {
          ".validate": "newData.val() === 'employee' || newData.val() === 'admin' || newData.val() === 'superadmin'"
        },
        "adminAccess": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "LeaveRequests": {
      ".read": true,
      "$employeeId": {
        "$requestId": {
          ".read": true,
          ".write": true
        }
      }
    },
    "Notifications": {
      ".read": true,
      "$employeeId": {
        "$notifId": {
          ".read": true,
          ".write": true
        }
      }
    },
    "AdminActivityLog": {
      ".read": true,
      ".write": true
    },
    "LeaveBalances": {
      ".read": true,
      "$employeeId": {
        ".read": true,
        ".write": true
      }
    },
    "DeviceApprovalRequests": {
      ".read": true,
      "$employeeId": {
        "$requestId": {
          ".read": true,
          ".write": true
        }
      }
    },
    "AdminNotifications": {
      ".read": true,
      ".write": true
    },
    "Announcements": {
      ".read": true,
      ".write": true
    },
    "WorkFromHomeRequests": {
      ".read": true,
      "$employeeId": {
        "$dateKey": {
          ".read": true,
          ".write": true
        }
      }
    },
    "AdminMessages": {
      ".read": true,
      "$messageId": {
        ".read": true,
        ".write": true
      }
    },
    "PayslipRequests": {
      ".read": true,
      "$employeeId": {
        "$requestId": {
          ".read": true,
          ".write": true
        }
      }
    }
  }
}
